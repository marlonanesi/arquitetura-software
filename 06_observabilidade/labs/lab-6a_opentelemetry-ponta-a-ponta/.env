# Qual configuração o Collector usa: collector-jaeger.yaml ou collector-zipkin.yaml
COLLECTOR_CONFIG=collector-jaeger.yaml

# Tempo (ms) da transportadora lenta. É ela que esconde segundos de latência.
VIASUL_MS=2800

# 1 = o serviço "rotas" propaga o contexto de rastreamento; 0 = não propaga
ROTAS_PROPAGA=1
